<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@drawable/bg_gradient">

    <GridLayout
        android:id="@+id/gridBoard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:rowCount="3"
        android:columnCount="3"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_score_section"
        android:padding="8dp">

        <Button
            android:id="@+id/button1"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textSize="40sp"
            android:textStyle="bold"
            android:layout_margin="4dp"
            android:background="@drawable/bg_button"
            android:textColor="@color/text_on_surface" />

        <Button
            android:id="@+id/button2"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textSize="40sp"
            android:textStyle="bold"
            android:layout_margin="4dp"
            android:background="@drawable/bg_button"
            android:textColor="@color/text_on_surface" />

        <Button
            android:id="@+id/button3"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textSize="40sp"
            android:textStyle="bold"
            android:layout_margin="4dp"
            android:background="@drawable/bg_button"
            android:textColor="@color/text_on_surface" />

        <Button
            android:id="@+id/button4"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textSize="40sp"
            android:textStyle="bold"
            android:layout_margin="4dp"
            android:background="@drawable/bg_button"
            android:textColor="@color/text_on_surface" />

        <Button
            android:id="@+id/button5"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textSize="40sp"
            android:textStyle="bold"
            android:layout_margin="4dp"
            android:background="@drawable/bg_button"
            android:textColor="@color/text_on_surface" />

        <Button
            android:id="@+id/button6"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textSize="40sp"
            android:textStyle="bold"
            android:layout_margin="4dp"
            android:background="@drawable/bg_button"
            android:textColor="@color/text_on_surface" />

        <Button
            android:id="@+id/button7"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textSize="40sp"
            android:textStyle="bold"
            android:layout_margin="4dp"
            android:background="@drawable/bg_button"
            android:textColor="@color/text_on_surface" />

        <Button
            android:id="@+id/button8"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textSize="40sp"
            android:textStyle="bold"
            android:layout_margin="4dp"
            android:background="@drawable/bg_button"
            android:textColor="@color/text_on_surface" />

        <Button
            android:id="@+id/button9"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textSize="40sp"
            android:textStyle="bold"
            android:layout_margin="4dp"
            android:background="@drawable/bg_button"
            android:textColor="@color/text_on_surface" />

    </GridLayout>

    <TextView
        android:id="@+id/textStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/you_go_first"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_light"
        android:gravity="center"
        android:layout_marginBottom="20dp"
        android:shadowColor="#80000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="4" />

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_score_section"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/textScoreHuman"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/green_x"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true" />

        <TextView
            android:id="@+id/textScoreTie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_light"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp" />

        <TextView
            android:id="@+id/textScoreAndroid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/red_o"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true" />

    </RelativeLayout>

</LinearLayout>
